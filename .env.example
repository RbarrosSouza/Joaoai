# =====================================================================
# João.ai — Variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha com os valores reais.
# NUNCA commite `.env.local` (já está no .gitignore).
# =====================================================================

# URL do projeto Supabase (https://<project_ref>.supabase.co)
VITE_SUPABASE_URL=

# Anon key do Supabase (JWT). Use a `anon public` key, não a service_role.
# A service_role NUNCA pode ir pra cá — ela só roda em N8N / backend.
VITE_SUPABASE_ANON_KEY=

# Opcional: publishable key (fallback para auth quando anon não funciona)
# VITE_SUPABASE_PUBLISHABLE_KEY=
